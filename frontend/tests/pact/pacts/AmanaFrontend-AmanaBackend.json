{
  "consumer": {
    "name": "AmanaFrontend"
  },
  "interactions": [
    {
      "description": "a request to build a deposit transaction",
      "providerStates": [
        {
          "name": "a trade exists in CREATED status"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock-token"
        },
        "method": "POST",
        "path": "/api/v1/trades/4294967297/deposit"
      },
      "response": {
        "body": {
          "unsignedXdr": "AAAAAXNvbWUtZGVwb3NpdC10eC14ZHI="
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.unsignedXdr": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[A-Za-z0-9+/=]+"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to confirm delivery",
      "providerStates": [
        {
          "name": "a trade exists in FUNDED status"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock-token"
        },
        "method": "POST",
        "path": "/api/v1/trades/4294967297/confirm"
      },
      "response": {
        "body": {
          "unsignedXdr": "AAAAAXNvbWUtY29uZmlybS14ZHI="
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.unsignedXdr": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[A-Za-z0-9+/=]+"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to create a trade",
      "providerStates": [
        {
          "name": "a buyer is authenticated"
        }
      ],
      "request": {
        "body": {
          "amountUsdc": "100.00",
          "buyerLossBps": 5000,
          "sellerAddress": "GA4T33YK6H6D5E7ZQY5W3J2L7F8K9B0N1M2P3Q4R5S6T7U8V9W0X1Y2Z3",
          "sellerLossBps": 5000
        },
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock-token",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/trades"
      },
      "response": {
        "body": {
          "tradeId": "4294967297",
          "unsignedXdr": "AAAAAXNvbWUtY3JlYXRlLXRyYWRlLXhkcg=="
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.tradeId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "\\d+"
                }
              ]
            },
            "$.unsignedXdr": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[A-Za-z0-9+/=]+"
                }
              ]
            }
          }
        },
        "status": 201
      }
    },
    {
      "description": "a request to get a trade by id",
      "providerStates": [
        {
          "name": "a trade exists with id 4294967297"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock-token"
        },
        "method": "GET",
        "path": "/api/v1/trades/4294967297"
      },
      "response": {
        "body": {
          "amountUsdc": "100.00",
          "buyerAddress": "GDNM7WSJ7VIUVK2TSZ2OQES5XR2663TZEIBFXRDT56B5IRLHERVWSXMU",
          "buyerLossBps": 5000,
          "createdAt": "2026-01-01T00:00:00.000Z",
          "sellerAddress": "GA4T33YK6H6D5E7ZQY5W3J2L7F8K9B0N1M2P3Q4R5S6T7U8V9W0X1Y2Z3",
          "sellerLossBps": 5000,
          "status": "CREATED",
          "tradeId": "4294967297",
          "updatedAt": "2026-01-01T00:00:00.000Z"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.buyerAddress": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.createdAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
                  "match": "datetime"
                }
              ]
            },
            "$.sellerAddress": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.updatedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
                  "match": "datetime"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to get trade stats",
      "providerStates": [
        {
          "name": "the user has trade statistics"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock-token"
        },
        "method": "GET",
        "path": "/api/v1/trades/stats"
      },
      "response": {
        "body": {
          "openTrades": 3,
          "totalTrades": 10,
          "totalVolume": 250000
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "a request to initiate a dispute",
      "providerStates": [
        {
          "name": "a trade exists in FUNDED status"
        }
      ],
      "request": {
        "body": {
          "category": "delivery_issue",
          "reason": "Goods not delivered as agreed"
        },
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock-token",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/trades/4294967297/dispute"
      },
      "response": {
        "body": {
          "unsignedXdr": "AAAAAXNvbWUtZGlzcHV0ZS14ZHI="
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.unsignedXdr": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[A-Za-z0-9+/=]+"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to list trades",
      "providerStates": [
        {
          "name": "the user has trades"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock-token"
        },
        "method": "GET",
        "path": "/api/v1/trades",
        "query": {
          "limit": [
            "10"
          ],
          "page": [
            "1"
          ]
        }
      },
      "response": {
        "body": {
          "items": [
            {
              "amountUsdc": "100.00",
              "buyerAddress": "GDNM7WSJ7VIUVK2TSZ2OQES5XR2663TZEIBFXRDT56B5IRLHERVWSXMU",
              "buyerLossBps": 5000,
              "createdAt": "2026-01-01T00:00:00.000Z",
              "sellerAddress": "GA4T33YK6H6D5E7ZQY5W3J2L7F8K9B0N1M2P3Q4R5S6T7U8V9W0X1Y2Z3",
              "sellerLossBps": 5000,
              "status": "CREATED",
              "tradeId": "4294967297",
              "updatedAt": "2026-01-01T00:00:00.000Z"
            }
          ],
          "pagination": {
            "limit": 10,
            "page": 1,
            "total": 1,
            "totalPages": 1
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.items[*].buyerAddress": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].createdAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
                  "match": "datetime"
                }
              ]
            },
            "$.items[*].sellerAddress": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].updatedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
                  "match": "datetime"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
